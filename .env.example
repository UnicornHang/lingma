# ============================================
# ZhiMeng Novel Studio - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际配置
#   cp .env.example .env

# ==================== 基础配置 ====================
# 应用环境：development | production
APP_ENV=production

# 应用密钥（用于加密 API Key 等敏感数据）
# 生产环境必须修改为 32+ 字符的随机字符串
# 可用命令生成: openssl rand -hex 32
APP_SECRET=change-me-to-random-32-chars-string-please

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ==================== 服务端口 ====================
# 后端服务端口（容器内固定 8000）
BACKEND_PORT=8000
# 前端端口（宿主机访问端口）
FRONTEND_PORT=7860

# ==================== 数据库 ====================
# SQLite 数据库 URL（默认使用 Docker 卷挂载路径）
DATABASE_URL=sqlite+aiosqlite:////app/data/works/zhimeng.db

# ==================== 向量库 ====================
# Chroma 向量库存储路径
VECTOR_STORE_PATH=/app/data/vector_store

# Embedding 模型：
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (本地，多语言)
#   - BAAI/bge-small-zh-v1.5 (本地，中文优化)
#   - text-embedding-3-small (OpenAI API，需要 API Key)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==================== LLM API Keys ====================
# 至少配置一个，否则系统无法生成内容

# OpenAI (GPT-5 系列)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5

# Anthropic (Claude Opus 5)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5-20251101

# DeepSeek (性价比之王)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Qwen/通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ==================== 本地模型 ====================
# Ollama 服务地址（Docker 容器内使用 http://ollama:11434）
# 宿主机直接访问使用 http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# LM Studio (OpenAI 兼容接口)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ==================== 限流 ====================
# 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=60

# 最大并发 LLM 调用数
MAX_CONCURRENT_LLM=3

# ==================== 前端构建参数 ====================
# API Base URL（前端构建时使用）
VITE_API_BASE=/api/v1
# WebSocket Base URL
VITE_WS_BASE=ws://localhost:7860
# 应用版本号
VITE_APP_VERSION=0.1.0

# ==================== 可选功能 ====================
# 是否启用 Redis 任务队列（生产环境推荐）
USE_REDIS=false

# 是否启用 Ollama 本地模型
USE_OLLAMA=false

# 数据备份目录(相对路径或绝对路径;Docker 内建议 /app/data/backups)
BACKUP_DIR=./backups
# 默认保留备份份数
BACKUP_KEEP_DEFAULT=10
# 单次导入作品包最大字节(默认 50MB)
IMPORT_MAX_BYTES=52428800