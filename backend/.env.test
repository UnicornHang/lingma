# Test Environment
APP_ENV=development
APP_SECRET=test-secret-for-unit-tests-32chars-min-length-required-please
LOG_LEVEL=WARNING

BACKEND_PORT=8000
WORKERS=1

# 内存数据库用于测试
DATABASE_URL=sqlite+aiosqlite:///:memory:

VECTOR_STORE_PATH=/tmp/zhimeng-test-vector
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

RATE_LIMIT_PER_MINUTE=1000
MAX_CONCURRENT_LLM=10

# 不使用 Redis
REDIS_URL=

CORS_ORIGINS=["http://localhost:7860", "http://localhost:3000"]